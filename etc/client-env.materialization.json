{
  "schemaVersion": 1,
  "kind": "sdkwork.client-env-materialization",
  "application": "sdkwork-memory",
  "command": "pnpm workflow:materialize-client-env",
  "deploymentConfig": "sdkwork.deployment.config.json",
  "sourceIdentity": {
    "deploymentProfileKeys": [
      "SDKWORK_MEMORY_DEPLOYMENT_PROFILE",
      "SDKWORK_DEPLOYMENT_PROFILE"
    ],
    "environmentKeys": [
      "SDKWORK_MEMORY_ENVIRONMENT",
      "SDKWORK_ENVIRONMENT"
    ],
    "profileIdKeys": [
      "SDKWORK_MEMORY_PROFILE_ID",
      "SDKWORK_PROFILE_ID"
    ]
  },
  "profiles": [
    "standalone.development",
    "standalone.production",
    "cloud.development",
    "cloud.production",
    "standalone.test",
    "standalone.staging",
    "cloud.test",
    "cloud.staging",
    "standalone.demo",
    "cloud.demo"
  ],
  "surfaces": [
    {
      "id": "sdkwork-memory-pc",
      "root": "apps/sdkwork-memory-pc",
      "format": "vite",
      "runtimeTarget": "browser",
      "includePrefixes": [],
      "includeKeys": [],
      "bindings": {
        "VITE_SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL": {
          "sources": [
            "SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_MEMORY_PLATFORM_API_GATEWAY_HTTP_URL": {
          "sources": [
            "SDKWORK_MEMORY_PLATFORM_API_GATEWAY_HTTP_URL"
          ],
          "required": false
        },
        "VITE_SDKWORK_CORS_ALLOWED_ORIGINS": {
          "sources": [
            "SDKWORK_CORS_ALLOWED_ORIGINS"
          ],
          "required": false
        }
      },
      "constants": {
        "VITE_SDKWORK_APPLICATION_CODE": "memory",
        "VITE_SDKWORK_SURFACE": "pc"
      },
      "requiredOutputKeys": [
        "VITE_SDKWORK_ENVIRONMENT",
        "VITE_SDKWORK_DEPLOYMENT_PROFILE",
        "VITE_SDKWORK_PROFILE_ID",
        "VITE_SDKWORK_RUNTIME_TARGET"
      ],
      "accessToken": {
        "appId": "sdkwork-memory-pc",
        "tenantId": "100001",
        "organizationId": "0",
        "permissionScope": [
          "memory.spaces.read",
          "memory.records.read",
          "memory.candidates.read",
          "memory.habits.read",
          "memory.retrievals.write",
          "memory.app.entities.read",
          "memory.app.policies.write",
          "memory.backend.spaces.read",
          "memory.backend.records.read",
          "memory.backend.candidates.read",
          "memory.backend.indexes.read",
          "memory.backend.providerBindings.read",
          "memory.backend.evalRuns.read",
          "memory.backend.auditLogs.read",
          "memory.backend.commercialReadiness.read",
          "memory.backend.entities.read",
          "memory.backend.subjects.read"
        ]
      }
    }
  ]
}
