# Production deployments MUST use PostgreSQL and MUST NOT enable DEV_AUTH_BYPASS.
# Database URLs are injected via Kubernetes secrets or environment providers.
# Fixed IAM identity MUST NOT be defined in topology env files (per ENVIRONMENT_SPEC §6.1).

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MEMORY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MEMORY_DEPLOYMENT_PROFILE=cloud
SDKWORK_MEMORY_ENVIRONMENT=production
SDKWORK_MEMORY_CONFIG_PROFILE=production
SDKWORK_MEMORY_RUNTIME_TARGET=container
SDKWORK_MEMORY_PROFILE_ID=cloud.production

SDKWORK_MEMORY_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8080
SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL=http://sdkwork-api-memory-standalone-gateway.sdkwork-memory.svc.cluster.local:8080
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:8081
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_URL=http://sdkwork-memory-open-api.sdkwork-memory.svc.cluster.local:8081
SDKWORK_MEMORY_APPLICATION_APP_HTTP_BIND=0.0.0.0:8082
SDKWORK_MEMORY_APPLICATION_APP_HTTP_URL=http://sdkwork-memory-app-api.sdkwork-memory.svc.cluster.local:8082
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:8083
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_URL=http://sdkwork-memory-backend-api.sdkwork-memory.svc.cluster.local:8083

# Database URL is injected via SDKWORK_DATABASE_URL secret/env at runtime.
# IAM Database URL is injected via SDKWORK_DATABASE_URL secret/env at runtime.
SDKWORK_DATABASE_AUTO_MIGRATE=false

SDKWORK_CORS_ALLOWED_ORIGINS=https://memory.sdkwork.com,https://memory.birdcoder.com,https://memory.dtupay.com,https://memory.noaper.com,https://memory.sdkwork.cn,https://memory.birdcoder.cn,https://memory.dtupay.cn,https://memory.noaper.cn,https://memory.skubc.com,https://memory.skubc.cn,https://memory.zowalk.com,https://memory.zowalk.cn,https://memory.offer86.com,https://memory.offer86.cn,https://memory.86offer.com,https://memory.86offer.cn,https://memory-app.sdkwork.com,https://memory-app.birdcoder.com,https://memory-app.dtupay.com,https://memory-app.noaper.com,https://memory-app.sdkwork.cn,https://memory-app.birdcoder.cn,https://memory-app.dtupay.cn,https://memory-app.noaper.cn,https://memory-app.skubc.com,https://memory-app.skubc.cn,https://memory-app.zowalk.com,https://memory-app.zowalk.cn,https://memory-app.offer86.com,https://memory-app.offer86.cn,https://memory-app.86offer.com,https://memory-app.86offer.cn,https://memory-admin.sdkwork.com,https://memory-admin.birdcoder.com,https://memory-admin.dtupay.com,https://memory-admin.noaper.com,https://memory-admin.sdkwork.cn,https://memory-admin.birdcoder.cn,https://memory-admin.dtupay.cn,https://memory-admin.noaper.cn,https://memory-admin.skubc.com,https://memory-admin.skubc.cn,https://memory-admin.zowalk.com,https://memory-admin.zowalk.cn,https://memory-admin.offer86.com,https://memory-admin.offer86.cn,https://memory-admin.86offer.com,https://memory-admin.86offer.cn,https://memory-open.sdkwork.com,https://mem.sdkwork.com,https://memory-open.birdcoder.com,https://memory-open.dtupay.com,https://memory-open.noaper.com,https://memory-open.sdkwork.cn,https://memory-open.birdcoder.cn,https://memory-open.dtupay.cn,https://memory-open.noaper.cn,https://memory-open.skubc.com,https://memory-open.skubc.cn,https://memory-open.zowalk.com,https://memory-open.zowalk.cn,https://memory-open.offer86.com,https://memory-open.offer86.cn,https://memory-open.86offer.com,https://memory-open.86offer.cn,app://dsh,app://birdcoder,app://sdk