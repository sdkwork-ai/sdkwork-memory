# Build artifacts

# Generated SDK local regeneration output & compiled sourcemaps (not committed)
*.js.map
*.d.ts.map
sdks/**/*-typescript/src/index.js
sdks/**/*-typescript/src/index.d.ts

# --- SDKWork: generated TypeScript SDK build outputs (never committed) ---
**/generated/server-openapi/src/**/*.js
**/generated/server-openapi/src/**/*.js.map
**/generated/server-openapi/src/**/*.d.ts
**/generated/server-openapi/src/**/*.d.ts.map
**/composed/**/*.js
**/composed/**/*.js.map
**/composed/**/*.d.ts
**/composed/**/*.d.ts.map

# Local scratch and build residue (do not commit)
tmp/
.tmp/

# Python bytecode (do not commit)
__pycache__/

# Local assistant state (do not commit)
.workbuddy/

# --- SDKWork: external reference checkouts (read-only upstream sources) ---
# Vendored upstream projects used as alignment references only. They are never
# part of the delivery, never built, and never committed. See
# docs/engineering/reviews/ for the alignment matrices produced against them.
external/
