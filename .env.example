# Safe checked-in example for SDKWork Memory local development.
# Copy to `.env` and replace credentials before running `pnpm dev`.
# For PostgreSQL development, copy `.env.postgres.example` instead.
# `node tools/check-env-documentation.mjs` (part of `pnpm check`) fails when a
# variable read under crates/ or plugins/ is missing from this file.

# === Runtime profile ===
SDKWORK_MEMORY_ENVIRONMENT=development
SDKWORK_MEMORY_CONFIG_PROFILE=dev
SDKWORK_MEMORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MEMORY_RUNTIME_TARGET=container
# Application root used to resolve app-owned paths; defaults to the repository
# root when unset.
# SDKWORK_MEMORY_APP_ROOT=.

# === Local bind ===
SDKWORK_MEMORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080

# === Development-only auth bypass ===
# Enables in-process dev identity without real IAM tokens.
# MUST be false in any shared or production environment.
SDKWORK_MEMORY_DEV_AUTH_BYPASS=true

# === SECURITY-SENSITIVE: IAM dev-auth fallback (framework-level key) ===
# Read by sdkwork-web-bootstrap's IAM adapter, not by Memory code directly.
# SECURITY: leave unset/false. When true, a missing or invalid IAM token can
# fall back to a development identity. Default is OFF; enabling it in a shared
# or production environment bypasses authentication. Startup in
# production-like environments fails closed regardless.
# SDKWORK_IAM_ALLOW_DEV_AUTH_FALLBACK=false

# === Dev identity defaults (only honored when DEV_AUTH_BYPASS=true) ===
# These are NOT fixed IAM identities for shared environments (per ENVIRONMENT_SPEC §6.1).
# They are local dev defaults used solely by the bypass shim.
SDKWORK_MEMORY_TENANT_ID=100001
SDKWORK_MEMORY_USER_ID=9001

# === Snowflake node id (single-node dev only) ===
SDKWORK_MEMORY_SNOWFLAKE_NODE_ID=1

# === Database (SQLite in-memory for quick dev) ===
SDKWORK_DATABASE_URL=sqlite::memory:
# Storage engine override: "sqlite" or "postgres"/"postgresql". Default is
# inferred from SDKWORK_DATABASE_URL.
# SDKWORK_DATABASE_ENGINE=sqlite
# Applies embedded migrations at startup. Default false: production applies the
# baseline through the release migration job (deployments/kubernetes/migration-job.yaml).
# SDKWORK_DATABASE_AUTO_MIGRATE=false

# === Tenant quotas (0 = unlimited). See PERFORMANCE_SPEC.md. ===
# SDKWORK_MEMORY_MAX_RECORDS_PER_SPACE=100000
# SDKWORK_MEMORY_MAX_SPACES_PER_USER=100

# === API admission (per-instance, not distributed) ===
# Maximum request body size in bytes (default: 1048576 = 1 MiB).
# SDKWORK_MEMORY_MAX_BODY_BYTES=1048576
# Maximum concurrent in-flight requests (default: 256).
# SDKWORK_MEMORY_MAX_CONCURRENCY=256
# Request deadline in seconds; accepted range 1..=300, default 30.
# SDKWORK_MEMORY_HTTP_REQUEST_TIMEOUT_SECS=30

# === CORS (framework-level key) ===
# Comma-separated allowlist read by sdkwork-web-bootstrap. Required for browser
# clients (PC Console/Admin) hitting the gateway cross-origin.
# SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# === Outbox delivery ===
# Delivery mode: "log" (default) or "http".
# SDKWORK_MEMORY_OUTBOX_DELIVERY_MODE=log
# Webhook URL for HTTP delivery mode.
# SDKWORK_MEMORY_OUTBOX_DELIVERY_URL=
# Delivery timeout in seconds (default: 10).
# SDKWORK_MEMORY_OUTBOX_DELIVERY_TIMEOUT_SECS=10
# Parallel HTTP deliveries (default: 16, clamped to 1..=64).
# SDKWORK_MEMORY_OUTBOX_DELIVERY_CONCURRENCY=16
# Lease duration in seconds (default: max(2 x delivery timeout, 30), floor:
# delivery timeout + 5).
# SDKWORK_MEMORY_OUTBOX_LEASE_DURATION_SECS=30
# Maximum delivery retries before marking event as failed (default: 5).
# SDKWORK_MEMORY_OUTBOX_MAX_RETRIES=5
# Poll interval for pending outbox events in seconds (default: 2).
# SDKWORK_MEMORY_OUTBOX_POLL_INTERVAL_SECS=2
# Stale processing requeue threshold in seconds (default: 300).
# SDKWORK_MEMORY_OUTBOX_STALE_PROCESSING_SECS=300

# === Background workers ===
# Learning job worker: poll interval seconds (default 2), concurrency (default
# 8, clamped 1..=32), lease seconds (default 900, floor 30), max attempts
# (default 5, clamped 1..=20), requeue backoff seconds (default 30).
# SDKWORK_MEMORY_JOB_POLL_INTERVAL_SECS=2
# SDKWORK_MEMORY_JOB_CONCURRENCY=8
# SDKWORK_MEMORY_JOB_LEASE_DURATION_SECS=900
# SDKWORK_MEMORY_JOB_MAX_ATTEMPTS=5
# SDKWORK_MEMORY_JOB_RETRY_BACKOFF_SECS=30
# Eval run worker: poll interval seconds (default 5), concurrency (default 4,
# clamped 1..=16), lease seconds (default 900, floor 30), max attempts
# (default 5, clamped 1..=20).
# SDKWORK_MEMORY_EVAL_POLL_INTERVAL_SECS=5
# SDKWORK_MEMORY_EVAL_CONCURRENCY=4
# SDKWORK_MEMORY_EVAL_LEASE_DURATION_SECS=900
# SDKWORK_MEMORY_EVAL_MAX_ATTEMPTS=5
# Provider health probe: interval seconds (default 60) and per-probe
# concurrency (default 8, clamped 1..=32).
# SDKWORK_MEMORY_PROVIDER_HEALTH_PROBE_SECS=60
# SDKWORK_MEMORY_PROVIDER_HEALTH_CONCURRENCY=8
# Provider bindings materialized per health aggregation (default 500); results
# past the cap are reported as a truncated degraded summary, not an error.
# SDKWORK_MEMORY_PROVIDER_HEALTH_MAX_BINDINGS=500

# === Retrieval and implementation profile ===
# Retrieval strategy: balanced (default), additive_hybrid, search_first, or
# event_aware.
# SDKWORK_MEMORY_RETRIEVAL_STRATEGY=balanced
# Implementation selection: auto (default), native_sql, or local_embedded.
# SDKWORK_MEMORY_IMPLEMENTATION_PROFILE=auto
# Metrics dimension override; default is inferred from the database engine.
# SDKWORK_MEMORY_RUNTIME_PROFILE=sqlite

# === Semantic provider (OpenAI-compatible; optional) ===
# Setting an API key turns the semantic channel on; without it the system stays
# embedding-optional (additive retrieval degrades to pure lexical ranking).
# SDKWORK_MEMORY_OPENAI_API_KEY=<secret>
# SDKWORK_MEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
# SDKWORK_MEMORY_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# SDKWORK_MEMORY_OPENAI_EMBEDDING_DIMENSIONS=1536
# SDKWORK_MEMORY_OPENAI_CHAT_MODEL=gpt-4o-mini
# SDKWORK_MEMORY_OPENAI_TIMEOUT_SECS=30
# Per-request embeddings input byte budget (default 2097152 = 2 MiB, clamped
# to 65536..=16777216; a single text above the budget is truncated).
# SDKWORK_MEMORY_EMBED_BATCH_MAX_BYTES=2097152

# === SDKWork Drive export upload (required for driveTargetRef exports) ===
# SDKWORK_DATABASE_URL=sqlite://./.sdkwork/memory/drive/dev.sqlite
# SDKWORK_MEMORY_DRIVE_OBJECT_STORE_ROOT=./.sdkwork/memory/drive/objects
# Drive upload payload cap in bytes (default: 67108864 = 64 MiB, absolute cap
# 268435456 = 256 MiB).
# SDKWORK_MEMORY_DRIVE_EXPORT_MAX_BYTES=67108864
# Production S3-compatible object store (optional; seeds provider when set):
# SDKWORK_MEMORY_DRIVE_S3_ENDPOINT=https://s3.example.com
# SDKWORK_MEMORY_DRIVE_S3_REGION=us-east-1
# SDKWORK_MEMORY_DRIVE_S3_BUCKET=memory
# Path-style addressing (default: true).
# SDKWORK_MEMORY_DRIVE_S3_PATH_STYLE=true
# Verify TLS certificates (default: true; auto-off only for http:// endpoints).
# SDKWORK_MEMORY_DRIVE_S3_STRICT_TLS=true
# SDKWORK_DRIVE_S3_ACCESS_KEY_ID=<access-key>
# SDKWORK_DRIVE_S3_SECRET_ACCESS_KEY=<secret-key>
# SDKWORK_MEMORY_DRIVE_S3_CREDENTIAL_REF=env:sdkwork-drive-s3
# Legacy non-prefixed fallbacks read only when the canonical
# SDKWORK_MEMORY_DRIVE_* keys above are absent. Prefer the canonical keys.
# SDKWORK_DRIVE_OBJECT_STORE_ROOT=
# SDKWORK_DRIVE_S3_REGION=
# SDKWORK_DRIVE_S3_CREDENTIAL_REF=

# === Export and extraction resource bounds (defaults shown) ===
# Concurrent export runs per process: each run holds its payload in memory, so
# this caps the product of per-run byte caps and in-flight requests.
# SDKWORK_MEMORY_EXPORT_MAX_CONCURRENCY=2
# Per-run collection ceilings in rows (default: 100000 each).
# SDKWORK_MEMORY_EXPORT_MAX_RECORDS=100000
# SDKWORK_MEMORY_EXPORT_MAX_EVENTS=100000
# Inline (response-body) export payload cap in bytes: default 4194304 = 4 MiB,
# absolute cap 33554432 = 32 MiB regardless of this setting.
# SDKWORK_MEMORY_INLINE_EXPORT_MAX_BYTES=4194304
# Set true/1 to disable export endpoints entirely (default: exports enabled).
# SDKWORK_MEMORY_EXPORT_DISABLED=false
# Database pool ceiling. Startup refuses a production-like value below 4: the
# retention and provider-health lease workers each pin one dedicated pool
# connection for a whole lease window. Default when unset: 10.
# SDKWORK_DATABASE_MAX_CONNECTIONS=32
# Total extracted event content bytes per extraction run; events past the
# budget are reported as skippedEventCount instead of inflating the prompt.
# SDKWORK_MEMORY_EXTRACTION_MAX_INPUT_BYTES=2097152
# Maximum input events covered per extraction run (default: 1000).
# SDKWORK_MEMORY_EXTRACTION_MAX_EVENTS=1000

# === Logging and tracing ===
# "json" forces structured logs; default is text unless
# SDKWORK_MEMORY_ENVIRONMENT=production.
# SDKWORK_MEMORY_LOG_FORMAT=text
# Head-sampling ratio for OTel traces, clamped to 0.0..=1.0 (default 1.0 =
# sample everything). Requires the `otel` release feature and an OTLP endpoint.
# SDKWORK_TRACING_SAMPLE_RATIO=1.0

# === Optional OpenTelemetry OTLP export (release image built with `otel` feature). ===
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# === Access token (required for production; obtain from IAM) ===
# SDKWORK_ACCESS_TOKEN=<jwt-access-token>

# === Production-required: per-deployment cursor signing key (fail-fast in production) ===
# SDKWORK_MEMORY_CURSOR_SIGNING_KEY=<random-32+-byte-secret>

# === Production-required: shared Redis for rate limiting, idempotency, admission (fail-fast in production) ===
# SDKWORK_MEMORY_WEB_REDIS_URL=redis://127.0.0.1:6379
# Legacy fallback read only when SDKWORK_MEMORY_WEB_REDIS_URL is absent.
# SDKWORK_REDIS_URL=

# === Graceful shutdown ===
# Background-plane drain budget in seconds (default: 240). Shutdown is ordered
# HTTP-first: in-flight requests finish, then workers drain within this budget.
# Keep it under the orchestrator's terminationGracePeriodSeconds.
# SDKWORK_MEMORY_SHUTDOWN_DRAIN_SECS=240

# === Retention worker windows in days (0 disables a sweep; defaults shown) ===
# SDKWORK_MEMORY_RETENTION_SWEEP_INTERVAL_SECS=3600
# SDKWORK_MEMORY_RETENTION_OUTBOX_TERMINAL_DAYS=7
# SDKWORK_MEMORY_RETENTION_JOBS_TERMINAL_DAYS=30
# SDKWORK_MEMORY_RETENTION_TRACES_DAYS=30
# SDKWORK_MEMORY_RETENTION_AUDIT_DAYS=90
